<section class="stats-bar w-full h-auto bg-overlay-grid border-b border-t border-lime-brand-hover flex items-center justify-center">
    
    <div class="max-w-6xl w-full flex items-center justify-between py-6">
        <div class="stat-item flex flex-col justify-center gap-0">
            <span class="stat-value text-lime-brand text-xl font-bold">50+</span>
            <span class="stat-label text-sm text-grey-muted">Builds delivered</span>
        </div>

        <div class="stat-item flex flex-col justify-center gap-0">
            <span class="stat-value text-lime-brand text-xl font-bold">3</span>
            <span class="stat-label text-sm text-grey-muted">Builders on Staff</span>
