            <span class="stat-label text-sm text-grey-muted">Personalized</span>
        </div>

        <div class="stat-item flex flex-col justify-center gap-0">
            <span class="stat-value text-lime-brand text-xl font-bold">12h</span>
            <span class="stat-label text-sm text-grey-muted">Minimum Response Time</span>
        </div>

        <div class="stat-item flex flex-col justify-center gap-0">
            <span class="stat-value text-lime-brand text-xl font-bold">1 Week</span>
            <span class="stat-label text-sm text-grey-muted">Minimum Delivery Time</span>
        </div>
    </div>
    
